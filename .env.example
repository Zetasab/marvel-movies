# Copia este archivo como .env.local si quieres probar en local el build de producción.
# En GitHub Pages no hace falta: el workflow (.github/workflows/deploy.yml) las rellena solo.

# URL pública de la web, sin barra final (canonical, Open Graph, sitemap y JSON-LD)
NEXT_PUBLIC_SITE_URL=https://usuario.github.io/marvel-movies

# Ruta bajo la que cuelga la web: /<nombre-del-repo>. Vacía con un repo usuario.github.io o con dominio propio
NEXT_PUBLIC_BASE_PATH=/marvel-movies

# Opcional: código de Google Search Console (método "etiqueta HTML", solo el valor de content="…")
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
